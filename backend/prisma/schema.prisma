  workspaceId  String
  name         String
  siteUrl      String?
  webhookUrl   String           @unique
  webhookToken String           @unique
  isActive     Boolean          @default(true)
  fieldMapping String           @default("{}")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  submissions  FormSubmission[]

  @@index([workspaceId])
  @@index([webhookToken])
  @@map("form_webhooks")
}

model FormSubmission {
  id             String        @id @default(uuid())
  formWebhookId  String
  workspaceId    String
  contactId      String?
  conversationId String?
  formData       String        @default("{}")
  name           String?
  email          String?
  phone          String?
  company        String?
  message        String?
  status         String        @default("NEW")
  source         String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  formWebhook    FormWebhook   @relation(fields: [formWebhookId], references: [id], onDelete: Cascade)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
