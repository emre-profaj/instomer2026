  fieldData      String        @default("{}")
  name           String?
  email          String?
  phone          String?
  status         String        @default("NEW")
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  facebookPage   FacebookPage? @relation(fields: [facebookPageId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([facebookPageId])
  @@index([formId])
  @@index([status])
  @@map("facebook_leads")
}

model Appointment {
  id             String   @id @default(uuid())
  workspaceId    String
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  assignedToId   String?
  resourceId     String?
  contactId      String?
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  status         String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  color          String   @default("#3b82f6")
  reminderSent   Boolean  @default(false)
  notes          String?
  createdById    String
  // Bot-created appointment fields
  createdByBotId String? // Which bot created this appointment
  conversationId String? // Which conversation it came from
  branch         String? // Branch name (Dahiliye, Ortopedi, etc.)
  procedure      String? // Procedure type
  doctorName     String? // Doctor name
  googleEventId  String? // Google Calendar Event ID
  googleMeetLink String? // Google Meet link if generated
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workspaceId])
  @@index([assignedToId])
  @@index([resourceId])
  @@index([startTime])
  @@index([status])
  @@index([googleEventId])
