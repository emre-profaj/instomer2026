// Scheduled AI Calls
model ScheduledCall {
  id               String   @id @default(uuid())
  workspaceId      String
  contactId        String?
  contactName      String?
  toNumber         String
  agentId          String?
  scheduledAt      DateTime
  status           String   @default("PENDING") // PENDING, COMPLETED, FAILED, CANCELLED
  retellCallId     String?
  errorMessage     String?
  createdById      String
  dynamicVariables String?  @db.Text // JSON: { customer_name, interest_topic, source, custom_instruction, ... }
  attemptNumber    Int      @default(1) // 1., 2., 3. deneme
  maxAttempts      Int      @default(3) // Maksimum deneme sayısı
  retryDelayMin    Int      @default(60) // Tekrar arama arası (dakika)
  parentCallId     String? // İlk planlamanın ID'si (retry zinciri)
  conversationId   String? // İlgili sohbet
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

