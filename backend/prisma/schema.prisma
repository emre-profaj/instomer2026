  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  module         RealEstateModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  apartmentTypes ApartmentType[]
  units          ApartmentUnit[]
  campaigns      Campaign[]
  offers         PaymentOffer[]

  @@index([moduleId])
  @@map("real_estate_projects")
}

model ApartmentType {
  id          String            @id @default(uuid())
  projectId   String
  name        String
  roomCount   String?
  floor       String?
  grossArea   Float?
  netArea     Float?
  direction   String?
  listPrice   Float             @default(0)
  cashPrice   Float             @default(0)
  currency    String            @default("TRY")
  features    String            @default("[]")
  description String?
  sitePlanUrl String?
  floorPlans  String?
  order       Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     RealEstateProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units       ApartmentUnit[]
  offers      PaymentOffer[]

  @@index([projectId])
  @@map("apartment_types")
}

model ApartmentUnit {
  id              String            @id @default(uuid())
  projectId       String
  apartmentTypeId String?
  unitCode        String
  block           String?
  floor           String?
  doorNumber      String?
  description     String?
  status          String            @default("AVAILABLE")
  customPrice     Float?
  reservedBy      String?
  reservedAt      DateTime?
  soldAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  project         RealEstateProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apartmentType   ApartmentType?    @relation(fields: [apartmentTypeId], references: [id], onDelete: SetNull)
  offers          PaymentOffer[]

  @@index([projectId])
  @@index([apartmentTypeId])
  @@index([status])
  @@map("apartment_units")
}

model Campaign {
  id                  String            @id @default(uuid())
  projectId           String
  name                String
  monthlyInterestRate Float             @default(0)
  minDownPaymentRate  Float             @default(20)
  flexDownPaymentRate Float? // Esneme ile inen minimum peşinat (ör. standart %50, esnek %40)
  maxInstallments     Int               @default(24)
  discountTiers       String? // JSON: [{months, discountRate, label}] — vadeye göre indirim tablosu
  description         String?
  endDate             DateTime?
  offerValidityType   String            @default("DAYS")
  offerValidityDays   Int               @default(7)
  order               Int               @default(0)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  project             RealEstateProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  offers              PaymentOffer[]

  @@index([projectId])
  @@map("campaigns")
}

model PaymentOffer {
  id               String            @id @default(uuid())
  workspaceId      String
  projectId        String
  campaignId       String?
  apartmentTypeId  String?
  unitId           String?
  contactId        String?
  customerName     String
  customerPhone    String?
  customerEmail    String?
  agentName        String?
  listPrice        Float             @default(0)
  cashPrice        Float             @default(0)
  currency         String            @default("TRY")
  netPrice         Float             @default(0)
  downPayment      Float             @default(0)
  downPaymentRate  Float             @default(0)
  installmentCount Int               @default(0)
  monthlyPayment   Float             @default(0)
  interimPayments  String?
  avgVadeMonth     Float             @default(0)
  discountAmount   Float             @default(0)
  discountRate     Float             @default(0)
  paymentSchedule  String?
  notes            String?
  status           String            @default("DRAFT")
  validUntil       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  project          RealEstateProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaign         Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  apartmentType    ApartmentType?    @relation(fields: [apartmentTypeId], references: [id], onDelete: SetNull)
  unit             ApartmentUnit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
  @@map("payment_offers")
}

model ApiIntegration {
  id            String   @id @default(uuid())
  workspaceId   String
  name          String
  baseUrl       String
  authType      String   @default("NONE") // NONE, BEARER, BASIC, API_KEY, OAUTH_PASSWORD
  authToken     String? // Encrypted
  apiKey        String? // Encrypted
  apiSecret     String? // Encrypted
  headers       String? // JSON string formatında özel header'lar
  assignedBotId String? // Atanmış AI bot
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedBot AIBot?      @relation("ApiIntegrationBot", fields: [assignedBotId], references: [id], onDelete: SetNull)
  botTools    AIBotTool[]

  @@index([workspaceId])
  @@map("api_integrations")
}

model AIBotTool {
  id               String   @id @default(uuid())
  workspaceId      String
  apiIntegrationId String?
  name             String
  description      String
  method           String   @default("GET")
  endpoint         String
  parametersSchema String? // JSON string
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiIntegration ApiIntegration? @relation(fields: [apiIntegrationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([apiIntegrationId])
  @@map("ai_bot_tools")
}

model ContactActivity {
  id           String    @id @default(uuid())
  contactId    String
  workspaceId  String
  type         String // "NOTE", "CALL", "MEETING", "TASK", "REMINDER", "PROPOSAL", "ORDER", "INVOICE", "PAYMENT"
  title        String? // Görev veya etkinlik başlığı
  description  String?   @db.Text // Detaylı not veya içerik
  dueDate      DateTime? // Hatırlatıcı, görev veya toplantı tarihi
  isCompleted  Boolean   @default(false) // ← ESKİ ALAN — SİLİNMEDİ, yerinde duruyor
  status       String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED
  completedAt  DateTime? // Tamamlanma zamanı
  result       String?   @db.Text // Tamamlama notu / sonuç
  source       String    @default("MANUAL") // MANUAL | AUTOMATION | RETELL | SYSTEM
  priority     String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  assignedToId String? // Atanan agent (insan)
  teamId       String? // Atanan takım
  createdBy    String? // Oluşturan user id (Sistem/Bot ise null)

  // Atama Takibi
  assignedById   String? // Son atamayı yapan kişi
  assignedByType String    @default("USER") // USER | SYSTEM | AUTOMATION | BOT
  assignedAt     DateTime? // Son atama zamanı

  // ─── Birleşik Arama Planlama ───────────────────────────────
  callTopic            String? // Arama konusu (Obezite Cerrahisi, Tanurla Loft vb.)
  aiAgentId            String? // Doğrudan AI agent'a atandıysa
  fallbackToAi         Boolean @default(false) // İnsan yapmazsa AI devralsın mı?
  fallbackDelayMinutes Int     @default(60) // Kaç dk sonra AI devralır
  aiFallbackTriggered  Boolean @default(false) // AI devralma tetiklendi mi?
  // ──────────────────────────────────────────────────────────

  // ─── İnsan Araması Sonuç Bilgileri ────────────────────────
  callSuccessful Boolean? // true = ulaşıldı/konuşuldu, false = açmadı/kapattı
  callSentiment  String?  // "Positive", "Neutral", "Negative"
  // ──────────────────────────────────────────────────────────

  // Case (talep akışı) bağlantısı
  caseId       String?
  case         Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("ActivityAssignee", fields: [assignedToId], references: [id])
  creator   User?     @relation("ActivityCreator", fields: [createdBy], references: [id])
  team      Team?     @relation(fields: [teamId], references: [id])

  @@index([contactId, createdAt])
  @@index([workspaceId])
  @@index([status])
  @@index([type, status, dueDate]) // Overdue call query optimization
  @@index([caseId])
  @@map("contact_activities")
}

// Global Flow Templates for Super Admin
model FlowTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  trigger     String? // NEW_FORM, FIRST_MSG, TAG_ADDED
  steps       Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("flow_templates")
}

// Retell arama sırasında otomatik WhatsApp gönderimleri için aksiyon tanımları
model RetellAction {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String // Görünen isim: "Hastane Konumu Gönder"
  actionKey   String // Retell'den gelecek parametre: "location", "catalog", "location_kadikoy" vb.
  description String // Agent'a ne zaman kullanacağını anlatan açıklama (prompt gibi davranır)

  // Mesaj tipi: TEXT | LOCATION | DOCUMENT | VIDEO | TEMPLATE
  messageType String

  // TEXT tipi
  textContent String?

  // LOCATION tipi
  locationLat     Float?
  locationLng     Float?
  locationName    String?
  locationAddress String?

  // DOCUMENT / VIDEO tipi
  mediaUrl      String?
  mediaCaption  String?
  mediaFilename String? // PDF için dosya adı

  // TEMPLATE tipi
  templateName String? // WhatsApp şablon adı (sendTemplateDynamic ile eşleşir)

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@map("retell_actions")
}

// ─────────────────────────────────────────────────────────────────────────────
// CASE SİSTEMİ — Çoklu Talep/Sohbet Akışı
// Her kişi birden fazla case'e sahip olabilir. Her case bir konuyu temsil eder.
// Farklı kanallardan gelen yazışmalar aynı case altında birleştirilebilir.
// ─────────────────────────────────────────────────────────────────────────────

model Case {
  id             String    @id @default(uuid())
  workspaceId    String
  contactId      String
  caseNumber     String?   // CSE-2026-0001 (otomatik)
  title          String    // "Gastroenteroloji Randevu", "2+1 Daire"
  description    String?
  status         String    @default("ACTIVE") // ACTIVE, WON, LOST, CLOSED
  priority       String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT

  // Pipeline aşaması
  funnelType     String?   // Pipeline ID (Funnel)
  funnelStageId  String?   // Stage ID (FunnelStage)

  // Atama
  assignedToId   String?   // Atanan kişi
  assignedTeamId String?   // Atanan takım

  // Zaman
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  closedAt       DateTime?
  wonAt          DateTime?
  lostAt         DateTime?
  lostReason     String?

  // İlişkiler
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact        Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo     User?            @relation("CaseAssignee", fields: [assignedToId], references: [id])
  team           Team?            @relation(fields: [assignedTeamId], references: [id])
  conversations  Conversation[]
  activities     ContactActivity[]

  @@index([workspaceId])
  @@index([contactId])
  @@index([workspaceId, contactId, status])
  @@index([workspaceId, status])
  @@index([caseNumber])
  @@map("cases")
}

model Product {
  id              String   @id @default(uuid())
  workspaceId     String
  name            String
  description     String?
  groupName       String?
  unit            String?
  price           Float    @default(0)
  priceUSD        Float?
  priceEUR        Float?
  priceGBP        Float?
  discountedPrice Float?
  tax1Type        String?
  tax1Rate        Float    @default(0)
  tax2Type        String?
  tax2Rate        Float    @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, groupName])
  @@map("products")
}

model MarketingCampaign {
  id             String                    @id @default(uuid())
  workspaceId    String
  name           String
  description    String?
  templateId     String
  status         String                    @default("DRAFT") // DRAFT, SCHEDULED, RUNNING, COMPLETED, FAILED
  scheduledAt    DateTime?
  sentAt         DateTime?
  totalCount     Int                       @default(0)
  sentCount      Int                       @default(0)
  deliveredCount Int                       @default(0)
  readCount      Int                       @default(0)
  failedCount    Int                       @default(0)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  workspace      Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template       WhatsappTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recipients     MarketingRecipient[]

  @@index([workspaceId])
  @@map("marketing_campaigns")
}

model MarketingRecipient {
  id          String            @id @default(uuid())
  campaignId  String
  contactId   String?
  phone       String
  name        String?
  messageId   String?           @unique
  status      String            @default("PENDING") // PENDING, SENT, DELIVERED, READ, FAILED
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  failReason  String?
  sentAt      DateTime?
  createdAt   DateTime          @default(now())
  campaign    MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([messageId])
  @@map("marketing_recipients")
}
