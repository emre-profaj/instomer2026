// Temsilci Bazlı Google Takvim Entegrasyonu
model UserGoogleCalendar {
  id           String   @id @default(uuid())
  userId       String
  workspaceId  String
  googleEmail  String
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  expiryDate   BigInt?
  calendarId   String   @default("primary")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, googleEmail])
  @@index([userId])
  @@index([workspaceId])
  @@index([googleEmail])
  @@map("user_google_calendars")
}

// Randevu Asistanı — Branş / Şube Tanımları
model AppointmentBranch {
  id          String   @id @default(uuid())
  workspaceId String
  name        String // "Dahiliye", "Ortopedi", "Bornova Şube"
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Varsayılan atamalar
  defaultTeamId   String?
  defaultFunnelId String?

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  doctors          AppointmentDoctor[]
  productBranches  ProductBranch[]
  resourceBranches ResourceBranch[]
  cases            Case[]              @relation("CaseBranch")
  conversations    Conversation[]      @relation("ConversationBranch")

  // Şube adresi ve iletişim
  address       String?
  phone         String?
  googleMapsUrl String? // Şube Google Maps konum linki

  @@index([workspaceId])
  @@map("appointment_branches")
}

// @deprecated — CalendarResource + ResourceBranch kullanın. Bu model geriye uyumluluk için korunuyor.
// Randevu Asistanı — Doktor Tanımları (Legacy)
model AppointmentDoctor {
  id          String            @id @default(uuid())
  branchId    String
  name        String // "Dr. Ahmet Yılmaz"
  title       String? // "Prof. Dr.", "Uzm. Dr."
  userId      String? // Tied to an actual System User
  workingDays String? // JSON: ["monday","tuesday","wednesday","thursday","friday"]
  workStart   String? // "09:00"
  workEnd     String? // "17:00"
  slotMinutes Int               @default(30)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  branch      AppointmentBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("appointment_doctors")
}

model CalendarResource {
  id             String  @id @default(uuid())
  workspaceId    String
  name           String
  description    String?
  type           String  @default("ROOM") // ROOM, PERSON, THERAPIST, SPECIALIST, STAFF, EQUIPMENT, OTHER
  color          String  @default("#8b5cf6")
  isActive       Boolean @default(true)
  availableStart String? // "09:00"
  availableEnd   String? // "18:00"
  availableDays  String? // JSON: [1,2,3,4,5]
  branchId       String? // Legacy tekil şube ilişkisi (ResourceBranch'e taşınacak)

  // AppointmentDoctor'dan taşınan alanlar
  title       String? // "Prof. Dr.", "Uzm. Dr.", "Terapist"
  userId      String? // Sistem kullanıcısı (temsilci) bağlantısı
  slotMinutes Int     @default(30)

  // Entegrasyon ve Senkronizasyon Alanları
  syncProvider     String    @default("WORKSPACE_DEFAULT") // WORKSPACE_DEFAULT, MANUAL, PROBEL, GYMPRO, GOOGLE_CALENDAR
  externalId       String? // Harici sistem doktor/kaynak ID (örn. Probel doktor kodu)
  googleEmail      String? // Bağlı Google Takvim hesabı e-postası
  googleCalendarId String?   @default("primary")
  lastSyncedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Çoklu şube desteği
  resourceBranches ResourceBranch[]
  // Hangi ürünleri/hizmetleri yapabiliyor
  resourceProducts ResourceProduct[]

  @@index([workspaceId])
  @@index([branchId])
  @@index([userId])
  @@map("calendar_resources")
}

// Kaynak ↔ Şube (many-to-many)
model ResourceBranch {
  id          String   @id @default(uuid())
  resourceId  String
  branchId    String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  resource CalendarResource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  branch   AppointmentBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([resourceId, branchId])
  @@index([resourceId])
  @@index([branchId])
  @@map("resource_branches")
}

// Kaynak ↔ Ürün/Hizmet (fiyat ve süre ile)
model ResourceProduct {
  id         String   @id @default(uuid())
  resourceId String
  productId  String
  branchId   String? // Şube bazlı fiyat (null = genel fiyat)
  price      Float? // Bu kaynak bu hizmeti kaça yapıyor
  duration   Int? // Dakika cinsinden süre
  createdAt  DateTime @default(now())

  resource CalendarResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([resourceId, productId, branchId])
  @@index([resourceId])
  @@index([productId])
  @@map("resource_products")
}

// WhatsApp Message Templates
model WhatsappTemplate {
  id                    String   @id @default(uuid())
  workspaceId           String
  whatsappPhoneNumberId String?
  templateId            String // WhatsApp template ID from Meta
  name                  String
  language              String   @default("tr")
  category              String   @default("MARKETING") // MARKETING, UTILITY, AUTHENTICATION
  status                String   @default("APPROVED") // APPROVED, PENDING, REJECTED
  components            String   @default("[]") // JSON array of template components
  headerType            String? // TEXT, IMAGE, VIDEO, DOCUMENT
  headerContent         String? // Header text or media URL
  bodyText              String // Main template text with {{1}}, {{2}} placeholders
  footerText            String?
  buttons               String? // JSON array of buttons
  exampleValues         String? // JSON array of example values for placeholders
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  whatsappPhoneNumber WhatsappPhoneNumber? @relation(fields: [whatsappPhoneNumberId], references: [id], onDelete: SetNull)
  marketingCampaigns  MarketingCampaign[]

  @@unique([workspaceId, templateId])
  @@index([workspaceId])
  @@index([whatsappPhoneNumberId])
  @@index([status])
  @@map("whatsapp_templates")
}

// Automation Rules
model Automation {
  id               String   @id @default(uuid())
  workspaceId      String
  name             String
  description      String?
  isActive         Boolean  @default(true)
  trigger          String // NEW_LEAD, NEW_MESSAGE, NEW_CONVERSATION
  triggerChannel   String? // WHATSAPP, FACEBOOK, INSTAGRAM, ALL
  action           String // SEND_TEMPLATE, SEND_MESSAGE, ASSIGN_AGENT, SEND_EMAIL (legacy, single action)
  actions          String? // JSON array of actions [{ type, templateId, emailChannelId, etc }]
  actionLogic      String   @default("AND") // AND = all actions, OR = first matching
  templateId       String? // WhatsApp template ID if action is SEND_TEMPLATE
  messageContent   String? // Message content if action is SEND_MESSAGE
  assignToUserId   String? // User ID if action is ASSIGN_AGENT
  // Email action fields
  emailChannelId   String? // Email channel to send from
  emailSubject     String? // Email subject
  emailBody        String? // Email body content
  emailIsHtml      Boolean  @default(false) // Send as HTML or plain text
  delayMinutes     Int      @default(0) // Delay before executing action
  conditions       String? // JSON conditions for when to trigger
  // New action type fields
  targetFlowId     String? // CHANGE_FLOW: target flow/funnel ID
  targetTeamId     String? // ASSIGN_TEAM: target team ID
  reminderMessage  String? // SEND_REMINDER: reminder message content
  reminderDelayMin Int? // SEND_REMINDER: delay in minutes
  callAgentId      String? // START_CALL: Retell agent ID
  appointmentType  String? // SCHEDULE_APPOINTMENT: appointment type
  marketingTplId   String? // SEND_MARKETING: marketing template ID
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([isActive])
  @@index([trigger])
  @@map("automations")
}

// Workspace-level Automation Rules (Kurallar)
model WorkspaceRule {
  id            String       @id @default(uuid())
  workspaceId   String
  ruleType      String // PHONE_CAPTURE | HOT_KEYWORD | HOT_OPPORT_EMAIL | APPOINTMENT_REMINDER | QUOTE_REMINDER | DRIP_DAY_1 ...
  isActive      Boolean      @default(false)
  config        String       @default("{}") // JSON: { keywords:[], teamId, emailChannelId, label, needsTemplate }
  linkedStageId String? // Bağlı akış aşaması — bu aşamadaki kişilere çalışır
  linkedStage   FunnelStage? @relation("StageAutomationRules", fields: [linkedStageId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, ruleType, linkedStageId])
  @@index([workspaceId])
  @@index([linkedStageId])
  @@map("workspace_rules")
}

// Workspace-level Router Rules (Yönlendiriciler)
model RouterRule {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  isActive    Boolean   @default(true)
  priority    Int       @default(0)
  conditions  String    @default("{}") // JSON: { channels[], keywords[], matchMode, useAI, aiDescription }
  targets     String    @default("{}") // JSON: { funnelId, funnelName, teamId, botId }
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@map("router_rules")
}

// Visual Flow Builder Flows
model Flow {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  isActive    Boolean  @default(false)
  trigger     String? // NEW_FORM, FIRST_MSG, TAG_ADDED
  steps       Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Hierarchy: Ana Akış → Alt Akışlar (max 3 seviye)
  parentId    String?
  parent      Flow?   @relation("FlowHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Flow[]  @relation("FlowHierarchy")
  flowType    String  @default("SUB") // MAIN (triyaj/ana akış), SUB (alt akış)
  order       Int     @default(0) // Sıralama
  icon        String? // Emoji: 📊, 🛒, 🎧
  color       String? // Renk: #3b82f6
  description String? // Kısa açıklama

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([isActive])
  @@index([trigger])
  @@index([parentId])
  @@map("flows")
}

model FormWebhook {
