generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Global platform settings (singleton row)
model GlobalSettings {
  id             String   @id @default("singleton")
  globalAiApiKey String? // Super Admin tarafından girilen global AI API key
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("global_settings")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  password              String?
  name                  String
  avatar                String?
  role                  String                 @default("USER")
  facebookId            String?                @unique
  facebookAccessToken   String?
  isOnline              Boolean                @default(false)
  lastSeenAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  transfersTo           ConversationTransfer[] @relation("TransfersTo")
  transfersFrom         ConversationTransfer[] @relation("TransfersFrom")
  assignedConversations Conversation[]
  internalNotes         InternalNote[]
  sentMessages          Message[]
  teamMemberships       TeamMember[]
  schedules             UserSchedule[]
  workspaceMembers      WorkspaceMember[]
  ownedCompanies        Company[]              @relation("CompanyOwner")
  assignedDeals         Deal[]                 @relation("DealAssignee")
  notifications         Notification[]
  workingHours          Json?
  assignedActivities    ContactActivity[]      @relation("ActivityAssignee")
  createdActivities     ContactActivity[]      @relation("ActivityCreator")
  assignedCases         Case[]                 @relation("CaseAssignee")

  @@map("users")
}

// Firma (Company) - Birden fazla workspace içeren üst organizasyon
model Company {
  id                   String      @id @default(uuid())
  name                 String
  slug                 String      @unique
  description          String?
  logo                 String?
  ownerId              String // Firma sahibi (OWNER)
  owner                User        @relation("CompanyOwner", fields: [ownerId], references: [id])
  maxWorkspaces        Int         @default(3) // Firma altında oluşturulabilecek maksimum workspace sayısı
  // AI Kullanım Limitleri (Firma bazlı)
  dailyAiChatLimit     Int         @default(50)
  aiSubscriptionType   String      @default("FREE") // FREE, BASIC, PRO, UNLIMITED
  aiSubscriptionEndsAt DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  workspaces           Workspace[]

  @@index([ownerId])
  @@map("companies")
}

model Workspace {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  description         String?
  avatar              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  aiApiKey            String?
  // Company Info (workspace'e özel şirket bilgileri)
  companyName         String?
  companyDescription  String?
  companyAddress      String?
  companyPhone        String?
  companyEmail        String?
  companyWebsite      String?
  companyWorkingHours String?
  companyLogo         String?

  // Fatura ayarları
  invoiceTaxOffice String? // Vergi Dairesi
  invoiceTaxNumber String? // Vergi Numarası
  invoiceIban      String? // IBAN

  // Firma (Company) ilişkisi
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // AI Kullanım Limitleri (workspace bazlı - veya firmadan miras alınır)
  dailyAiChatLimit     Int       @default(50) // Günlük AI sohbet limiti (ücretsiz: 50)
  dailyAiChatCount     Int       @default(0) // Bugünkü kullanım sayısı
  lastAiCountResetAt   DateTime  @default(now()) // Son sıfırlama tarihi
  aiSubscriptionType   String    @default("FREE") // FREE, BASIC, PRO, UNLIMITED
  aiSubscriptionEndsAt DateTime? // Abonelik bitiş tarihi (null = süresiz)

  // Relations
  aiBots               AIBot[]
  contacts             Contact[]
  conversations        Conversation[]
  emailChannels        EmailChannel[]
  facebookPages        FacebookPage[]
  facebookLeads        FacebookLead[]
  teams                Team[]
  webWidget            WebWidget[]
  whatsappPhoneNumbers WhatsappPhoneNumber[]
  members              WorkspaceMember[]
  knowledgeBase        KnowledgeBase[]
  apiIntegrations      ApiIntegration[]
  whatsappTemplates    WhatsappTemplate[]
  automations          Automation[]
  formWebhooks         FormWebhook[]
  formSubmissions      FormSubmission[]
  invitations          Invitation[]
  deals                Deal[]
  retellCalls          RetellCall[]
  quickReplies         QuickReply[]
  scheduledCalls       ScheduledCall[]
  workspaceRules       WorkspaceRule[]
  routerRules          RouterRule[]
  funnels              Funnel[]
  calendarResources    CalendarResource[]
  flows                Flow[]
  contactActivities    ContactActivity[]
  appointmentBranches  AppointmentBranch[]
  botTools             AIBotTool[]
  retellActions        RetellAction[]
  cases                Case[]
  products             Product[]
  marketingCampaigns   MarketingCampaign[]

  // Retell AI Voice
  retellApiKey          String?
  retellAgentId         String?
  retellFromNumber      String?
  retellKnowledgeBaseId String? // Instomer KB → Retell sync sonrası oluşturulan KB ID

  // Retell Auto-Call Settings
  retellAutoCallEnabled  Boolean @default(false)
  retellAutoCallTriggers Json? // { onNewLead, onWhatsApp, onMessenger, onWebForm, onMissedChat }
  retellAutoCallDelay    Int     @default(30) // seconds to wait before calling
  retellAutoCallSchedule Json? // { start: "09:00", end: "18:00", days: [1,2,3,4,5] }

  // AI Devralma Ayarları (workspace seviyesi — genel varsayılan)
  aiFallbackEnabled      Boolean @default(false) // İnsan aramadığında AI devreye girsin mi?
  aiFallbackDelayMinutes Int     @default(60) // Kaç dk sonra AI devralır
  aiFallbackPoolEnabled  Boolean @default(false) // Havuzdaki sahipsiz görevleri AI alsın mı?

  // Gayrimenkul
  realEstateEnabled Boolean @default(false)

  // Varsayılan Dil (agent'ta boşsa buradan alınır)
  defaultLanguage String @default("tr-TR") // tr-TR, en-US, en-GB, de-DE, fr-FR, ar-SA, multi

  defaultFunnelId    String? // Varsayılan satış akışı ID'si

  @@index([companyId])
  @@map("workspaces")
}

model KnowledgeBase {
  id           String    @id @default(uuid())
  workspaceId  String
  title        String
  content      String
  sourceType   String    @default("TEXT")
  sourceUrl    String? // Web url ya da API url'si
  syncInterval Int? // Güncelleme sıklığı (saat cinsinden)
  lastSyncedAt DateTime? // Son güncelleme zamanı
  filename     String?
  fileType     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("knowledge_base")
}

model AIBot {
  id               String   @id @default(uuid())
  name             String
  role             String   @default("Teknik Servis")
  prompt           String?
  isActive         Boolean  @default(false)
  whatsappEnabled  Boolean  @default(false)
  facebookEnabled  Boolean  @default(false)
  instagramEnabled Boolean  @default(false)
  widgetEnabled    Boolean  @default(false)
  botType          String   @default("CHATS")
  workspaceId      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Scheduler: Bot active between these times
  schedulerEnabled  Boolean   @default(false)
  scheduleStartTime String? // Format: "HH:mm" (e.g., "09:00")
  scheduleEndTime   String? // Format: "HH:mm" (e.g., "18:00")
  scheduleStartDate DateTime? // Optional: Start date for scheduling
  scheduleEndDate   DateTime? // Optional: End date for scheduling
  scheduleDays      String? // JSON array of days: ["monday","tuesday",...]

  // Auto-reply delay: Send auto message if not replied within X seconds
  autoReplyDelayEnabled Boolean @default(false)
  autoReplyDelaySeconds Int     @default(30)
  autoReplyDelayMessage String? // Custom message to send after delay

  // Follow-up: Inactivity warning (LEGACY — kept for backward compat)
  inactivityWarningEnabled Boolean @default(false)
  inactivityWarningSeconds Int     @default(40)
  inactivityWarningMessage String? // Message to send after X seconds of customer inactivity

  // Follow-up: Daily reminder (LEGACY — kept for backward compat)
  dailyReminderEnabled Boolean @default(false)
  dailyReminderHours   Int     @default(24) // Hours after last bot message
  dailyReminderMessage String? // Reminder message (sent only once)

  // 5-Step Smart Reminder System (replaces legacy inactivity + daily)
  // JSON: [{enabled: bool, delayMinutes: int}] — up to 5 steps
  reminderSteps String?

  documents             AIBotDocument[]
  conversations         Conversation[]
  facebookPages         FacebookPage[]        @relation("FacebookBot")
  instagramPages        FacebookPage[]        @relation("InstagramBot")
  commentPages          FacebookPage[]        @relation("CommentBot")
  instagramCommentPages FacebookPage[]        @relation("InstagramCommentBot")
  whatsappPhoneNumbers  WhatsappPhoneNumber[]
  emailChannels         EmailChannel[]
  webWidgets            WebWidget[]
  teams                 Team[]
  teamMemberships       TeamMember[]
  workspace             Workspace             @relation(fields: [workspaceId], references: [id])

  // Routing Configuration
  routingEnabled            Boolean @default(false)
  routingQuestions          String? // JSON: [{ id, question, fieldName, fieldType, required }]
  routingDefaultTeamId      String? // Varsayılan takım
  routingDefaultUserId      String? // Varsayılan kişi
  routingConditionalEnabled Boolean @default(false)
  routingRules              String? // JSON: [{ id, field, operator, value, teamId, userId, priority }]

  // Linked Automations
  automations String? // JSON array of automation IDs: ["id1", "id2"]

  // Handoff: Custom message when bot can't answer and transfers to agent
  handoffMessage String? // e.g. "Bu konuda tam emin değilim. Sizi bir temsilcimize aktarmayı deneyeceğim..."

  // Health System API integrations assigned to this bot
  apiIntegrations ApiIntegration[] @relation("ApiIntegrationBot")
  funnelStages    FunnelStage[]    @relation("FunnelStageBot")

  @@index([workspaceId])
  @@map("ai_bots")
}

model AIBotDocument {
  id        String   @id @default(uuid())
  botId     String
  filename  String
  content   String
  fileType  String
  createdAt DateTime @default(now())
  bot       AIBot    @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  role        String    @default("AGENT")
  userId      String
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

model FacebookPage {
  id                    String         @id @default(uuid())
  pageId                String
  pageName              String
  pageAccessToken       String
  workspaceId           String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  instagramBusinessId   String?
  instagramUsername     String?
  assignedBotId         String?
  assignedBot           AIBot?         @relation("FacebookBot", fields: [assignedBotId], references: [id])
  instagramBotId        String?
  instagramBot          AIBot?         @relation("InstagramBot", fields: [instagramBotId], references: [id])
  commentBotId          String?
  commentBot            AIBot?         @relation("CommentBot", fields: [commentBotId], references: [id])
  instagramCommentBotId String?
  instagramCommentBot   AIBot?         @relation("InstagramCommentBot", fields: [instagramCommentBotId], references: [id])
  conversations         Conversation[]
  leads                 FacebookLead[]
  workspace             Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([pageId, workspaceId])
  @@index([workspaceId])
  @@index([pageId])
  @@map("facebook_pages")
}

model Contact {
  id                String            @id @default(uuid())
  workspaceId       String?
  workspace         Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String?
  fullName          String?
  email             String?
  phone             String?
  emails            String            @default("[]")
  phones            String            @default("[]")
  avatar            String?
  facebookId        String?           @unique
  instagramId       String?           @unique
  instagramUsername String?
  whatsappId        String?           @unique
  tags              String            @default("[]")
  status            String            @default("NEW")
  source            String            @default("MANUAL")
  category          String            @default("NEW") // NEW, CUSTOMER, OPPORTUNITY, SPAM, VIP, PARTNER, BLACKLIST
  funnelType        String? // Global stage category (e.g. Fırsat)
  funnelStageId     String? // Exact stage ID (e.g. Sıcak Fırsat)
  stageManuallySet  Boolean           @default(false) // Manuel aşama değişikliği yapıldı mı
  lastContactedAt   DateTime?
  isBlocked         Boolean           @default(false)
  blockedAt         DateTime?
  blockedReason     String?
  isArchived        Boolean           @default(false)
  archivedAt        DateTime?
  isDeleted         Boolean           @default(false)
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  conversations     Conversation[]
  formSubmissions   FormSubmission[]
  deals             Deal[]
  cases             Case[]
  company           String?
  notes             String?
  language          String?
  country           String?
  city              String?
  importGroup       String?
  activities        ContactActivity[]

  @@index([workspaceId])
  @@index([instagramId])
  @@index([whatsappId])
  @@map("contacts")
}

model Conversation {
  id                    String    @id @default(uuid())
  status                String    @default("OPEN")
  contactId             String
  workspaceId           String
  facebookPageId        String?
  assignedToId          String?
  assignedBotId         String?
  assignedBot           AIBot?    @relation(fields: [assignedBotId], references: [id])
  whatsappPhoneNumberId String?
  instagramBusinessId   String?
  emailChannelId        String?
  channel               String    @default("UNKNOWN")
  teamIds               String    @default("[]")
  unreadCount           Int       @default(0)
  lastMessageAt         DateTime  @default(now())
  resolvedAt            DateTime? // When conversation was marked as RESOLVED
  resolvedById          String? // Who resolved the conversation
  botEnabled            Boolean   @default(true) // Bot enabled for this conversation (false = kalıcı kapatma)
  botDelayedUntil       DateTime? // Bot will not respond until this time (for 30sec delay)
  botPausedUntil        DateTime? // Agent yazdığında geçici duraklama — süre dolunca bot devam eder
  assignedTeamId        String? // Team assigned to this conversation
  aiTopic               String? // AI-generated conversation topic
  aiSummary             String? // AI-generated conversation summary
  sentiment             String? // AI-generated sentiment (e.g., YÜKSEK İLGİLİ, KIZGIN vb.)
  sentimentScore        Int? // AI-generated sentiment score (0-100)
  funnelType            String? // Funnel category (e.g., SATIS, DESTEK, SIKAYET)
  funnelStageId         String? // Current stage within the funnel
  handoffPending        Boolean   @default(false) // Bot awaiting user confirmation for handoff

  // Atama Takibi
  assignedById   String? // Son atamayı yapan kişi
  assignedByType String    @default("USER") // USER | SYSTEM | AUTOMATION | BOT
  assignedAt     DateTime? // Son atama zamanı

  // UTM Takibi (reklam kaynağı)
  utmSource   String? // google, facebook, instagram
  utmMedium   String? // cpc, social, email, referral
  utmCampaign String? // kampanya adı
  utmTerm     String? // anahtar kelime
  utmContent  String? // reklam içeriği/varyant

  routingState          String? // JSON: { currentQuestionIndex, answers: { fieldName: value }, completed }
  appointmentState      String? // JSON: { step, data: { patientName, phone, branch, procedure, doctor, preferredDate, preferredTime } }
  // Evrensel Sınıflandırma
  classificationData    String?                @db.Text // JSON: {classification, extractedData, isQualifiedLead, reasoning}
  classifiedAt          DateTime? // Son sınıflandırma zamanı
  isQualifiedLead       Boolean                @default(false) // Hızlı filtreleme: İsim+Telefon+Konu tamam mı
  // Follow-up tracking
  lastBotMessageAt      DateTime? // When bot last sent a message
  inactivityWarningSent Boolean                @default(false) // LEGACY: 40s inactivity warning sent?
  reminderSentAt        DateTime? // LEGACY: 1-day reminder sent? (null = not sent)
  // Smart Reminder System
  reminderCount         Int                    @default(0) // Which reminder step was last sent (0-5)
  lastReminderAt        DateTime? // When last reminder was sent
  // Active Flow tracking
  activeFlowId          String? // Which flow is currently processing this conversation
  // Case (talep akışı) bağlantısı
  caseId                String?
  case                  Case?                  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  transfers             ConversationTransfer[]
  contact               Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  facebookPage          FacebookPage?          @relation(fields: [facebookPageId], references: [id])
  assignedTo            User?                  @relation(fields: [assignedToId], references: [id])
  whatsappPhoneNumber   WhatsappPhoneNumber?   @relation(fields: [whatsappPhoneNumberId], references: [id])
  emailChannel          EmailChannel?          @relation(fields: [emailChannelId], references: [id])
  internalNotes         InternalNote[]
  messages              Message[]
  events                ConversationEvent[]
  formSubmissions       FormSubmission[]
  deals                 Deal[]


  // Performance indexes for high-frequency cron queries
  @@index([workspaceId])
  @@index([status, botEnabled, assignedToId]) // processPendingBotResponses (every 30s)
  @@index([status, inactivityWarningSent, channel]) // processInactivityWarnings (every 30s)
  @@index([workspaceId, status, lastMessageAt]) // processNoReplyFlows (every 5m)
  @@index([contactId])
  @@index([assignedToId])
  @@index([workspaceId, funnelType, funnelStageId, lastMessageAt(sort: Desc)]) // Inbox funnel filter
  @@index([caseId])
  @@map("conversations")
}

model WhatsappPhoneNumber {
  id                 String             @id @default(uuid())
  phoneNumberId      String             @unique
  wabaId             String
  name               String?
  displayPhoneNumber String
  accessToken        String
  workspaceId        String
  assignedBotId      String?
  assignedBot        AIBot?             @relation(fields: [assignedBotId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  conversations      Conversation[]
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  templates          WhatsappTemplate[]

  @@map("whatsapp_phone_numbers")
}

model Message {
  id                String       @id @default(uuid())
  content           String
  messageType       String       @default("TEXT")
  mediaUrl          String?
  mediaType         String? // image, video, audio, document, sticker
  conversationId    String
  senderId          String?
  isFromContact     Boolean      @default(true)
  facebookMessageId String?      @unique
  whatsappMessageId String?      @unique
  status            String       @default("SENT") // SENT, DELIVERED, READ, FAILED
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  emailMessageId    String?      @unique
  emailSubject      String?
  sender            User?        @relation(fields: [senderId], references: [id])
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt]) // Cron jobs: find latest message per conversation
  @@map("messages")
}

model WebWidget {
  id                 String    @id @default(uuid())
  workspaceId        String
  name               String    @default("Web Widget") // e.g., "Ana Website", "Blog", "E-ticaret"
  siteUrl            String? // Optional website URL
  title              String    @default("Müşteri Destek")
  subtitle           String?   @default("Size nasıl yardımcı olabiliriz?")
  primaryColor       String    @default("#ef4444")
  greetingMessage    String?   @default("Merhaba! Size nasıl yardımcı olabilirim?")
  isActive           Boolean   @default(true)
  position           String    @default("RIGHT")
  width              Int       @default(350)
  prechatFormEnabled Boolean   @default(false) // Pre-chat form aktif/pasif
  ignoreSchedule     Boolean   @default(true) // true = widget bot schedule'ı yok sayar (7/24 çalışır)
  assignedBotId      String?
  assignedBot        AIBot?    @relation(fields: [assignedBotId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("web_widgets")
}

model EmailChannel {
  id              String         @id @default(uuid())
  email           String         @unique
  provider        String         @default("GMAIL") // GMAIL, IMAP (for Yandex, Webmail, Outlook etc.)
  accessToken     String? // For Gmail OAuth
  refreshToken    String? // For Gmail OAuth
  expiryDate      BigInt?
  workspaceId     String
  isActive        Boolean        @default(true)
  assignedBotId   String?
  assignedBot     AIBot?         @relation(fields: [assignedBotId], references: [id])
  lastSyncAt      DateTime?
  // Pub/Sub Watch fields
  historyId       String?
  watchExpiration DateTime?
  // Custom IMAP settings (for Yandex, Webmail, Outlook etc.)
  imapHost        String?
  imapPort        Int?           @default(993)
  imapUser        String?
  imapPass        String?
  imapSecure      Boolean        @default(true)
  // Custom SMTP settings
  smtpHost        String?
  smtpPort        Int?           @default(465)
  smtpUser        String?
  smtpPass        String?
  smtpSecure      Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  conversations   Conversation[]
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("email_channels")
}

model InternalNote {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  content        String
  mentionedUsers String       @default("[]")
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@map("internal_notes")
}

model ConversationTransfer {
  id             String       @id @default(uuid())
  conversationId String
  fromUserId     String
  toUserId       String?
  toTeamId       String?
  note           String?
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  team           Team?        @relation(fields: [toTeamId], references: [id])
  toUser         User?        @relation("TransfersTo", fields: [toUserId], references: [id])
  fromUser       User         @relation("TransfersFrom", fields: [fromUserId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([toTeamId])
  @@map("conversation_transfers")
}

// Konuşma Olay Günlüğü — timeline'da inline gösterilecek
model ConversationEvent {
  id             String   @id @default(uuid())
  conversationId String
  contactId      String
  workspaceId    String
  eventType      String // ASSIGNED, TEAM_CHANGED, FUNNEL_CHANGED, STAGE_CHANGED,
  // AUTOMATION_TRIGGERED, BOT_RESPONDED, MESSAGE_READ,
  // STATUS_CHANGED, TRANSFERRED, CLAIMED, CLASSIFIED
  title          String // Human-readable: "Dilan'a atandı"
  details        String?  @db.Text // JSON ek bilgiler
  actorId        String? // Kim tetikledi
  actorType      String   @default("SYSTEM") // USER, BOT, SYSTEM, AUTOMATION
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([conversationId, createdAt])
  @@index([workspaceId])
  @@map("conversation_events")
}

model Team {
  id              String  @id @default(uuid())
  workspaceId     String
  name            String
  description     String?
  color           String  @default("#3b82f6")
  assignedBotId   String?
  assignedBot     AIBot?  @relation(fields: [assignedBotId], references: [id])
  parentId        String?
  parent          Team?   @relation("TeamHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        Team[]  @relation("TeamHierarchy")
  assignmentRule  String  @default("POOL") // Legacy — uyumluluk için kalıyor
  roundRobinIndex Int     @default(0)

  // Havuz Dağıtım Kuralları
  distributionMode      String  @default("POOL")        // POOL | DISTRIBUTE | CONDITIONAL
  distributionMethod    String  @default("ROUND_ROBIN")  // ROUND_ROBIN | LEAST_BUSY | ONLINE_ONLY
  triggerOnPhone        Boolean @default(false)
  triggerOnEmail        Boolean @default(false)
  triggerOnAppointment  Boolean @default(false)
  triggerTimeoutMinutes Int?                              // null = süre yok

  // AI Devralma Ayarları (takım seviyesi — workspace'i override eder)
  aiFallbackEnabled      Boolean? // null = workspace ayarını kullan, true/false = override
  aiFallbackDelayMinutes Int? // null = workspace ayarını kullan

  createdAt       DateTime               @default(now())
  transfers       ConversationTransfer[]
  members         TeamMember[]
  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelRoutings ChannelRouting[]
  activities      ContactActivity[]
  cases           Case[]

  @@index([workspaceId])
  @@index([parentId])
  @@map("teams")
}

// Kanal → Ekip + Akış Yönlendirme
model ChannelRouting {
  id          String   @id @default(uuid())
  workspaceId String
  channel     String // INSTAGRAM, FACEBOOK, WHATSAPP, EMAIL, WEB_WIDGET, FORM, LEAD
  teamId      String
  funnelId    String?  // Hangi akışa yönlendirilecek
  pageId      String?  // Spesifik Facebook/Instagram sayfa ID veya WhatsApp numara ID
  accountName String?  // Hesap adı (görüntüleme amaçlı)
  botDelay    Int      @default(30) // Bot devreye girmeden önce bekleme süresi (saniye)
  botEnabled  Boolean  @default(true) // Bu kanal için bot aktif mi
  priority    Int      @default(0) // Birden fazla kural varsa öncelik
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  funnel      Funnel?  @relation("FunnelChannelRoutings", fields: [funnelId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, channel, pageId]) // Her kanal+sayfa için tek yönlendirme
  @@index([workspaceId])
  @@index([teamId])
  @@index([funnelId])
  @@map("channel_routings")
}

