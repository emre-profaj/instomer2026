// Sales Module - Deals (Teklifler, Siparişler, Faturalar)
model Deal {
  id          String  @id @default(uuid())
  workspaceId String
  contactId   String
  title       String
  description String?

  // Fiyatlama
  amount   Float  @default(0)
  currency String @default("TRY") // TRY, USD, EUR, GBP

  // Aşama ve Durum
  stage  String @default("QUOTE") // QUOTE, ORDER, INVOICE
  status String @default("OPEN") // OPEN, WON, LOST, OVERDUE

  // Ödeme Takibi
  dueDate     DateTime? // Son ödeme tarihi (vade)
  vatRate     Float     @default(0) // KDV oranı: 0, 10, 20
  paidAmount  Float     @default(0) // Ödenen tutar (kısmi ödeme desteği)
  paymentDate DateTime? // Ödeme gerçekleştiği tarih

  // Ürünler (JSON array)
  products String @default("[]") // [{ name, quantity, unitPrice, total }]

  // Numaralar (Teklif/Sipariş/Fatura numaraları)
  quoteNumber   String? // TEK-2026-0001
  orderNumber   String? // SIP-2026-0001
  invoiceNumber String? // FAT-2026-0001

  // Atama
  assignedToId String?

  // Atama Takibi
  assignedById   String? // Son atamayı yapan kişi
  assignedByType String  @default("USER") // USER | SYSTEM | AUTOMATION | BOT

  // Kaynak Takibi (sohbet/reklam kaynağı)
  conversationId String? // İlişkili sohbet
  channel        String? // WHATSAPP, FACEBOOK, INSTAGRAM, EMAIL, WIDGET
  sourceNote     String? // Serbest not: "Instagram reklamı", "Google Ads"

  // Protokol No (workspace-specific)
  protocolNo String?

  // Notlar
  notes String?

  // Durum Değişiklikleri
  wonAt      DateTime?
  lostAt     DateTime?
  lostReason String?

  // Dönüşüm Takibi (stage geçiş tarihleri)
  quoteCreatedAt   DateTime  @default(now())
  orderCreatedAt   DateTime?
  invoiceCreatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id])
  assignedTo   User?         @relation("DealAssignee", fields: [assignedToId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([workspaceId])
  @@index([contactId])
  @@index([stage])
  @@index([status])
  @@index([conversationId])
  @@map("deals")
}

model Notification {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  type        String // CONVERSATION_ASSIGNED, TEAM_ASSIGNED, BOT_ROUTING, NEW_MESSAGE
