// Funnel: User-defined pipeline categories
model Funnel {
  id                     String        @id @default(cuid())
  workspaceId            String
  name                   String
  color                  String        @default("#3b82f6")
  icon                   String        @default("📁")
  order                  Int           @default(0)
  funnelType             String        @default("SUB") // MAIN = Ana (Triyaj), SUB = Alt akış
  parentId               String?
  parent                 Funnel?       @relation("FunnelHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children               Funnel[]      @relation("FunnelHierarchy")
  assignedUserId         String?
  assignedTeamId         String?
  qualifiedLeadStageId   String?       // Nitelikli talepler (telefonu olan lead'ler) bu aşamaya düşer
  classificationCriteria String?       @db.Text // JSON: {keywords, sourcePages, formFields, aiDescription}
  isDefault              Boolean       @default(false) // true = silinemez varsayılan akış
  createdAt              DateTime      @default(now())
  workspace              Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages                 FunnelStage[]
  channelRoutings        ChannelRouting[] @relation("FunnelChannelRoutings")

  @@index([workspaceId])
  @@index([parentId])
  @@map("funnels")
}

// FunnelStage: Stages within a funnel (e.g., Yeni, İşlemde, Kapandı)
model FunnelStage {
  id             String   @id @default(cuid())
  funnelId       String
  name           String
  color          String   @default("#6b7280")
  order          Int      @default(0)
  assignedUserId String?
  assignedTeamId String?
  assignedBotId  String?
  assignedBot    AIBot?   @relation("FunnelStageBot", fields: [assignedBotId], references: [id], onDelete: SetNull)
  isClosing      Boolean  @default(false) // true = kapanış aşaması (Satış, Kayıp, Kapandı vb.)
  statusType     String?  // WON, LOST, CLOSED — null = ACTIVE (açık aşama). Case durumunu otomatik günceller.
  entryRules     String?  @db.Text // JSON: { matchType: 'ALL'|'ANY', rules: [{ type, field, values, ... }] }
  entryPriority  Int      @default(0) // Yüksek = önce kontrol edilir
  entryActions   String?  @db.Text // JSON: Aşamaya girişte yapılacak aksiyonlar
  timedActions   String?  @db.Text // JSON: Zamanlı aksiyonlar (X gün sonra hatırlat vb.)
  exitActions    String?  @db.Text // JSON: Aşamadan çıkışta yapılacak aksiyonlar
  requiredFields String?  @db.Text // JSON: Zorunlu alanlar/kayıtlar (not, teklif vb.)
  createdAt      DateTime @default(now())
  funnel         Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([funnelId])
  @@map("funnel_stages")
}

// Admin İşlem Geçmişi (Activity Log)
model AdminActivityLog {
  id         String   @id @default(uuid())
  userId     String
  userName   String
  action     String // CREATE_USER, DELETE_USER, UPDATE_USER, CREATE_WORKSPACE, DELETE_WORKSPACE, UPDATE_WORKSPACE, ADD_MEMBER, REMOVE_MEMBER, UPDATE_SETTINGS, UPDATE_AI_LIMIT, RESET_AI_COUNTER
  targetType String? // USER, WORKSPACE, SETTINGS, MEMBER
  targetId   String?
  targetName String?
  details    String? // JSON string for additional info
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_activity_logs")
}

