  @@index([email])
  @@index([workspaceId])
  @@index([token])
  @@index([status])
  @@map("invitations")
}

// Sales Module - Deals (Teklifler, Siparişler, Faturalar)
model Deal {
  id          String  @id @default(uuid())
  workspaceId String
  contactId   String
  title       String
  description String?

  // Fiyatlama
  amount   Float  @default(0)
  currency String @default("TRY") // TRY, USD, EUR, GBP

  // Aşama ve Durum
  stage  String @default("QUOTE") // QUOTE, ORDER, INVOICE
  status String @default("OPEN") // OPEN, WON, LOST, OVERDUE

  // Ödeme Takibi
  dueDate     DateTime? // Son ödeme tarihi (vade)
  vatRate     Float     @default(0) // KDV oranı: 0, 10, 20
  paidAmount  Float     @default(0) // Ödenen tutar (kısmi ödeme desteği)
  paymentDate DateTime? // Ödeme gerçekleştiği tarih

  // Ürünler (JSON array)
  products String @default("[]") // [{ name, quantity, unitPrice, total }]

  // Numaralar (Teklif/Sipariş/Fatura numaraları)
  quoteNumber   String? // TEK-2026-0001
  orderNumber   String? // SIP-2026-0001
  invoiceNumber String? // FAT-2026-0001

  // Atama
  assignedToId String?

  // Atama Takibi
  assignedById   String? // Son atamayı yapan kişi
  assignedByType String  @default("USER") // USER | SYSTEM | AUTOMATION | BOT

  // Kaynak Takibi (sohbet/reklam kaynağı)
  conversationId String? // İlişkili sohbet
  channel        String? // WHATSAPP, FACEBOOK, INSTAGRAM, EMAIL, WIDGET
  sourceNote     String? // Serbest not: "Instagram reklamı", "Google Ads"

  // Protokol No (workspace-specific)
  protocolNo String?

  // Notlar
  notes String?

  // Durum Değişiklikleri
  wonAt      DateTime?
  lostAt     DateTime?
  lostReason String?

  // Dönüşüm Takibi (stage geçiş tarihleri)
  quoteCreatedAt   DateTime  @default(now())
  orderCreatedAt   DateTime?
  invoiceCreatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id])
  caseId       String?
  case         Case?         @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignedTo   User?         @relation("DealAssignee", fields: [assignedToId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([workspaceId])
  @@index([contactId])
  @@index([stage])
  @@index([status])
  @@index([conversationId])
  @@map("deals")
}

model Notification {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  type        String // CONVERSATION_ASSIGNED, TEAM_ASSIGNED, BOT_ROUTING, NEW_MESSAGE
  title       String
  body        String
  data        String? // JSON - conversationId, teamId, etc.
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([workspaceId, userId])
  @@map("notifications")
}

model RetellCall {
  id             String    @id @default(uuid())
  workspaceId    String
  contactId      String?
  conversationId String?
  callId         String    @unique
  agentId        String?
  fromNumber     String
  toNumber       String
  direction      String    @default("outbound")
  status         String    @default("registered")
  duration       Int?
  startedAt      DateTime? // Retell'den gelen gerçek arama başlangıç zamanı (start_timestamp)
  transcript     String?   @db.Text
  recordingUrl   String?
  summary        String?
  sentiment      String?
  callSuccessful Boolean?
  cost           Float?
  endedReason    String?
  metadata       String?   @db.Text
  createdById    String    @default("")
  bulkBatchId    String? // FK to BulkCallBatch
  // Case (talep akışı) bağlantısı
  caseId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bulkBatch BulkCallBatch? @relation(fields: [bulkBatchId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([contactId])
  @@index([callId])
  @@index([caseId])
  @@index([bulkBatchId])
  @@map("retell_calls")
}

model BulkCallBatch {
  id          String   @id @default(uuid())
  workspaceId String
  agentId     String?
  agentName   String?
  // JSON array of { contactId, name, phone, status: 'queued'|'called'|'failed' }
  targets     String   @db.Text
  totalTarget Int      @default(0)
  totalCalled Int      @default(0)
  totalFailed Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  calls RetellCall[]

  @@index([workspaceId])
  @@map("bulk_call_batches")
}

// Quick Reply Templates (Hazır Mesajlar)
model QuickReply {
  id          String   @id @default(uuid())
  workspaceId String
  title       String
  content     String
  shortcut    String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("quick_replies")
}

// Scheduled AI Calls
model ScheduledCall {
  id               String   @id @default(uuid())
  workspaceId      String
  contactId        String?
  contactName      String?
  toNumber         String
  agentId          String?
  scheduledAt      DateTime
  status           String   @default("PENDING") // PENDING, COMPLETED, FAILED, CANCELLED
  retellCallId     String?
  errorMessage     String?
  createdById      String
  dynamicVariables String?  @db.Text // JSON: { customer_name, interest_topic, source, custom_instruction, ... }
  attemptNumber    Int      @default(1) // 1., 2., 3. deneme
  maxAttempts      Int      @default(3) // Maksimum deneme sayısı
  retryDelayMin    Int      @default(60) // Tekrar arama arası (dakika)
  parentCallId     String? // İlk planlamanın ID'si (retry zinciri)
  conversationId   String? // İlgili sohbet
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([scheduledAt])
  @@index([status])
  @@map("scheduled_calls")
}

// TopicCategory: Önceden tanımlı konu kategorileri (Obezite, Diz Protezi, vb.)
model TopicCategory {
  id          String   @id @default(cuid())
  workspaceId String
  name        String // "Obezite Cerrahisi"
  description String?  @db.Text // AI eşleştirme açıklaması
  icon        String? // Emoji ikonu
  color       String   @default("#6b7280")
  keywords    String?  @db.Text // JSON: ["obezite", "mide küçültme", "sleeve"]
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  parentId    String? // Alt kategori için üst kategori referansı
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Sektöre özel alanlar: JSON [{key, type, options, unit, required}]
  customFields    String? @db.Text
  // Varsayılan akış ve takım ataması
  defaultFunnelId String?
  defaultTeamId   String?
  // Legacy — alan veritabanında kalıyor, ilişki kaldırıldı
  caseTypeId      String?
  // Şube bağlantıları — JSON array: ["branch-id-1","branch-id-2"]
  // null veya [] = tüm şubelerde görünür
  branchIds       String? @db.Text

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent        TopicCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      TopicCategory[] @relation("CategoryHierarchy")
  conversations Conversation[]
  cases         Case[]
  products      Product[]

  @@index([workspaceId])
  @@index([parentId])
  @@map("topic_categories")
}

// CaseType: Vaka tipleri (Fırsat, Şikayet, İş Başvurusu vb.)
model CaseType {
  id          String  @id @default(uuid())
  workspaceId String
  name        String // "Fırsat", "Şikayet"
  systemCode  String? // Geriye dönük uyumluluk (FIRSAT, SIKAYET)
  color       String  @default("#eab308")
  icon        String?
  isActive    Boolean @default(true)
  order       Int     @default(0)

  cases Case[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("case_types")
}

// Funnel: User-defined pipeline categories
model Funnel {
  id                     String           @id @default(cuid())
  workspaceId            String
  name                   String
  color                  String           @default("#3b82f6")
  icon                   String           @default("📁")
  order                  Int              @default(0)
  funnelType             String           @default("SUB") // MAIN = Ana (Triyaj), SUB = Alt akış
  parentId               String?
  parent                 Funnel?          @relation("FunnelHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children               Funnel[]         @relation("FunnelHierarchy")
  assignedUserId         String?
  assignedTeamId         String?
  qualifiedLeadStageId   String? // Nitelikli talepler (telefonu olan lead'ler) bu aşamaya düşer
  classificationCriteria String?          @db.Text // JSON: {keywords, sourcePages, formFields, aiDescription}
  assignedBotId          String?
  assignedBot            AIBot?           @relation("FunnelBot", fields: [assignedBotId], references: [id], onDelete: SetNull)
  isDefault              Boolean          @default(false) // true = silinemez varsayılan akış
  createdAt              DateTime         @default(now())
  workspace              Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages                 FunnelStage[]
  channelRoutings        ChannelRouting[] @relation("FunnelChannelRoutings")

  @@index([workspaceId])
  @@index([parentId])
  @@map("funnels")
}

// FunnelStage: Stages within a funnel (e.g., Yeni, İşlemde, Kapandı)
model FunnelStage {
  id              String           @id @default(cuid())
  funnelId        String
  name            String
  color           String           @default("#6b7280")
  order           Int              @default(0)
  assignedUserId  String?
  assignedTeamId  String?
  assignedBotId   String?
  assignedBot     AIBot?           @relation("FunnelStageBot", fields: [assignedBotId], references: [id], onDelete: SetNull)
  isClosing       Boolean          @default(false) // true = kapanış aşaması (Satış, Kayıp, Kapandı vb.)
  statusType      String? // WON, LOST, CLOSED — null = ACTIVE (açık aşama). Case durumunu otomatik günceller.
  entryRules      String?          @db.Text // JSON: { matchType: 'ALL'|'ANY', rules: [{ type, field, values, ... }] }
  entryPriority   Int              @default(0) // Yüksek = önce kontrol edilir
  entryActions    String?          @db.Text // JSON: Aşamaya girişte yapılacak aksiyonlar
  timedActions    String?          @db.Text // JSON: Zamanlı aksiyonlar (X gün sonra hatırlat vb.)
  exitActions     String?          @db.Text // JSON: Aşamadan çıkışta yapılacak aksiyonlar
  requiredFields  String?          @db.Text // JSON: Zorunlu alanlar/kayıtlar (not, teklif vb.)
  createdAt       DateTime         @default(now())
  funnel          Funnel           @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  contacts        Contact[]
  channelRoutings ChannelRouting[] @relation("ChannelRoutingStage")

  // YENİ: Aşama bazlı AI davranışı
  aiGoal             String? @db.Text // "Bu aşamada müşteriyi randevuya yönlendir"
  aiInstruction      String? @db.Text // "Müşteriyle görüşme saati belirle, telefon numarası al"
  transitionCriteria String? @db.Text // JSON: { conditions: [{ field: "phone", op: "exists" }], autoTransition: true }

  // Bağlı otomasyon kuralları (Otomasyonlar sayfasından)
  automationRules WorkspaceRule[] @relation("StageAutomationRules")

  @@index([funnelId])
  @@map("funnel_stages")
}

// Admin İşlem Geçmişi (Activity Log)
model AdminActivityLog {
  id         String   @id @default(uuid())
  userId     String
  userName   String
  action     String // CREATE_USER, DELETE_USER, UPDATE_USER, CREATE_WORKSPACE, DELETE_WORKSPACE, UPDATE_WORKSPACE, ADD_MEMBER, REMOVE_MEMBER, UPDATE_SETTINGS, UPDATE_AI_LIMIT, RESET_AI_COUNTER
  targetType String? // USER, WORKSPACE, SETTINGS, MEMBER
  targetId   String?
  targetName String?
  details    String? // JSON string for additional info
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_activity_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// GAYRIMENKUL MODÜLÜ
// ─────────────────────────────────────────────────────────────────────────────

model RealEstateModule {
  id              String              @id @default(uuid())
  workspaceId     String              @unique
  moduleType      String              @default("BASIC")
  isActive        Boolean             @default(true)
  legalDisclaimer String?
  companyLogo     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  projects        RealEstateProject[]

  @@map("real_estate_modules")
}

model RealEstateProject {
  id             String           @id @default(uuid())
  moduleId       String
  name           String
  description    String?
  location       String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  module         RealEstateModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  apartmentTypes ApartmentType[]
  units          ApartmentUnit[]
  campaigns      Campaign[]
  offers         PaymentOffer[]

  @@index([moduleId])
  @@map("real_estate_projects")
}

model ApartmentType {
  id          String            @id @default(uuid())
  projectId   String
  name        String
  roomCount   String?
  floor       String?
  grossArea   Float?
  netArea     Float?
  direction   String?
  listPrice   Float             @default(0)
  cashPrice   Float             @default(0)
  currency    String            @default("TRY")
  features    String            @default("[]")
  description String?
  sitePlanUrl String?
  floorPlans  String?
  order       Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     RealEstateProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units       ApartmentUnit[]
  offers      PaymentOffer[]

  @@index([projectId])
  @@map("apartment_types")
}

model ApartmentUnit {
  id              String            @id @default(uuid())
  projectId       String
  apartmentTypeId String?
  unitCode        String
  block           String?
  floor           String?
  doorNumber      String?
  description     String?
  status          String            @default("AVAILABLE")
  customPrice     Float?
  reservedBy      String?
  reservedAt      DateTime?
  soldAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  project         RealEstateProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apartmentType   ApartmentType?    @relation(fields: [apartmentTypeId], references: [id], onDelete: SetNull)
  offers          PaymentOffer[]

  @@index([projectId])
  @@index([apartmentTypeId])
  @@index([status])
  @@map("apartment_units")
}

model Campaign {
  id                  String            @id @default(uuid())
  projectId           String
  name                String
  monthlyInterestRate Float             @default(0)
  minDownPaymentRate  Float             @default(20)
  flexDownPaymentRate Float? // Esneme ile inen minimum peşinat (ör. standart %50, esnek %40)
  maxInstallments     Int               @default(24)
  discountTiers       String? // JSON: [{months, discountRate, label}] — vadeye göre indirim tablosu
  description         String?
  endDate             DateTime?
  offerValidityType   String            @default("DAYS")
  offerValidityDays   Int               @default(7)
  order               Int               @default(0)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  project             RealEstateProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  offers              PaymentOffer[]

  @@index([projectId])
  @@map("campaigns")
}

model PaymentOffer {
  id               String            @id @default(uuid())
  workspaceId      String
  projectId        String
  campaignId       String?
  apartmentTypeId  String?
  unitId           String?
  contactId        String?
  customerName     String
  customerPhone    String?
  customerEmail    String?
  agentName        String?
  listPrice        Float             @default(0)
  cashPrice        Float             @default(0)
  currency         String            @default("TRY")
  netPrice         Float             @default(0)
  downPayment      Float             @default(0)
  downPaymentRate  Float             @default(0)
  installmentCount Int               @default(0)
  monthlyPayment   Float             @default(0)
  interimPayments  String?
  avgVadeMonth     Float             @default(0)
  discountAmount   Float             @default(0)
  discountRate     Float             @default(0)
  paymentSchedule  String?
  notes            String?
  status           String            @default("DRAFT")
  validUntil       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  project          RealEstateProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaign         Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  apartmentType    ApartmentType?    @relation(fields: [apartmentTypeId], references: [id], onDelete: SetNull)
  unit             ApartmentUnit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
  @@map("payment_offers")
}

model ApiIntegration {
  id            String   @id @default(uuid())
  workspaceId   String
  name          String
  baseUrl       String
  authType      String   @default("NONE") // NONE, BEARER, BASIC, API_KEY, OAUTH_PASSWORD
  authToken     String? // Encrypted
  apiKey        String? // Encrypted
  apiSecret     String? // Encrypted
  headers       String? // JSON string formatında özel header'lar
  assignedBotId String? // Atanmış AI bot
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedBot AIBot?      @relation("ApiIntegrationBot", fields: [assignedBotId], references: [id], onDelete: SetNull)
  botTools    AIBotTool[]

  @@index([workspaceId])
  @@map("api_integrations")
}

model AIBotTool {
  id               String   @id @default(uuid())
  workspaceId      String
  apiIntegrationId String?
  name             String
  description      String
  method           String   @default("GET")
  endpoint         String
  parametersSchema String? // JSON string
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiIntegration ApiIntegration? @relation(fields: [apiIntegrationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([apiIntegrationId])
  @@map("ai_bot_tools")
}

model ContactActivity {
  id           String    @id @default(uuid())
  contactId    String
  workspaceId  String
  type         String // "NOTE", "CALL", "MEETING", "TASK", "REMINDER", "PROPOSAL", "ORDER", "INVOICE", "PAYMENT"
  title        String? // Görev veya etkinlik başlığı
  description  String?   @db.Text // Detaylı not veya içerik
  dueDate      DateTime? // Hatırlatıcı, görev veya toplantı tarihi
  isCompleted  Boolean   @default(false) // ← ESKİ ALAN — SİLİNMEDİ, yerinde duruyor
  status       String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED
  completedAt  DateTime? // Tamamlanma zamanı
  result       String?   @db.Text // Tamamlama notu / sonuç
  source       String    @default("MANUAL") // MANUAL | AUTOMATION | RETELL | SYSTEM
  priority     String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  assignedToId String? // Atanan agent (insan)
  teamId       String? // Atanan takım
  createdBy    String? // Oluşturan user id (Sistem/Bot ise null)

  // Atama Takibi
  assignedById   String? // Son atamayı yapan kişi
  assignedByType String    @default("USER") // USER | SYSTEM | AUTOMATION | BOT
  assignedAt     DateTime? // Son atama zamanı

  // ─── Birleşik Arama Planlama ───────────────────────────────
  callTopic            String? // Arama konusu (Obezite Cerrahisi, Tanurla Loft vb.)
  aiAgentId            String? // Doğrudan AI agent'a atandıysa
  fallbackToAi         Boolean @default(false) // İnsan yapmazsa AI devralsın mı?
  fallbackDelayMinutes Int     @default(60) // Kaç dk sonra AI devralır
  aiFallbackTriggered  Boolean @default(false) // AI devralma tetiklendi mi?
  // ──────────────────────────────────────────────────────────

  // ─── İnsan Araması Sonuç Bilgileri ────────────────────────
  callSuccessful Boolean? // true = ulaşıldı/konuşuldu, false = açmadı/kapattı
  callSentiment  String? // "Positive", "Neutral", "Negative"
  // ──────────────────────────────────────────────────────────

  // Case (talep akışı) bağlantısı
  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("ActivityAssignee", fields: [assignedToId], references: [id])
  creator   User?     @relation("ActivityCreator", fields: [createdBy], references: [id])
  team      Team?     @relation(fields: [teamId], references: [id])

  sourceType     String? // STAGE_ACTION | HUMAN | RETELL
  retellExcluded Boolean @default(false) // true = Retell cannot pick up this task

  @@index([contactId, createdAt])
  @@index([workspaceId])
  @@index([status])
  @@index([type, status, dueDate]) // Overdue call query optimization
  @@index([caseId])
  @@map("contact_activities")
}

// ─── Kaynak Takibi (Attribution) ──────────────────────────────
// Her lead'in nereden geldiğini takip eder:
// Google Ads (gclid), Meta Ads (fbclid, ad_id), UTM parametreleri,
// Form ID'leri, WhatsApp reklam referansları, landing page bilgisi
model ContactAttribution {
  id          String @id @default(uuid())
  contactId   String
  workspaceId String

  // ─── Google ────────────────────────────────────────────────
  gclid        String? // Google Ads Click ID
  utm_source   String? // google, facebook, instagram, email
  utm_medium   String? // cpc, social, email, organic
  utm_campaign String? // yaz_kampanyasi_2026
  utm_content  String? // banner_v2, video_ad
  utm_term     String? // diş implant fiyat

  // ─── Meta (Facebook/Instagram) ─────────────────────────────
  fbclid           String? // Facebook Click ID
  fb_ad_id         String? // Reklam ID
  fb_adset_id      String? // AdSet ID
  fb_campaign_id   String? // Kampanya ID
  fb_ad_name       String? // Reklam adı
  fb_campaign_name String? // Kampanya adı

  // ─── WhatsApp Reklam ───────────────────────────────────────
  wa_referral_headline    String? // Click-to-WhatsApp reklam başlığı
  wa_referral_body        String? // Reklam gövdesi
  wa_referral_source_id   String? // Kaynak ID (ad_id)
  wa_referral_source_type String? // ad, post, organic
  wa_ctwa_clid            String? // Click-to-WhatsApp Click ID

  // ─── Meta Lead Gen Form ────────────────────────────────────
  meta_lead_form_id   String? // Meta Lead Ads form ID
  meta_lead_form_name String? // Form adı

  // ─── Web Form ──────────────────────────────────────────────
  form_id         String? // Elementor/WordPress form ID
  form_name       String? // Form adı
  form_webhook_id String? // FormWebhook kaydı ID

  // ─── Genel ─────────────────────────────────────────────────
  landing_page String? // İlk giriş sayfası URL'si
  referrer     String? // Yönlendiren site (google.com, instagram.com)
  channel      String? // WHATSAPP, FACEBOOK, INSTAGRAM, FORM, EMAIL, WEB_WIDGET
  ip_address   String? // Ziyaretçi IP adresi
  user_agent   String? // Tarayıcı bilgisi
  raw_data     String? @db.Text // Tüm ham kaynak verisi (JSON)

  createdAt DateTime @default(now())

  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([workspaceId])
  @@index([channel])
  @@index([utm_source])
  @@index([fb_campaign_id])
  @@index([gclid])
  @@map("contact_attributions")
}

// Global Flow Templates for Super Admin
model FlowTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  trigger     String? // NEW_FORM, FIRST_MSG, TAG_ADDED
  steps       Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("flow_templates")
}

// Retell arama sırasında otomatik WhatsApp gönderimleri için aksiyon tanımları
model RetellAction {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String // Görünen isim: "Hastane Konumu Gönder"
  actionKey   String // Retell'den gelecek parametre: "location", "catalog", "location_kadikoy" vb.
  description String // Agent'a ne zaman kullanacağını anlatan açıklama (prompt gibi davranır)

  // Mesaj tipi: TEXT | LOCATION | DOCUMENT | VIDEO | TEMPLATE
  messageType String

  // TEXT tipi
  textContent String?

  // LOCATION tipi
  locationLat     Float?
  locationLng     Float?
  locationName    String?
  locationAddress String?

  // DOCUMENT / VIDEO tipi
  mediaUrl      String?
  mediaCaption  String?
  mediaFilename String? // PDF için dosya adı

  // TEMPLATE tipi
  templateName String? // WhatsApp şablon adı (sendTemplateDynamic ile eşleşir)

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@map("retell_actions")
}

// ─────────────────────────────────────────────────────────────────────────────
// CASE SİSTEMİ — Çoklu Talep/Sohbet Akışı
// Her kişi birden fazla case'e sahip olabilir. Her case bir konuyu temsil eder.
// Farklı kanallardan gelen yazışmalar aynı case altında birleştirilebilir.
// ─────────────────────────────────────────────────────────────────────────────

model Case {
  id          String  @id @default(uuid())
  workspaceId String
  contactId   String
  caseNumber  String? // CSE-2026-0001 (otomatik)
  title       String // "Gastroenteroloji Randevu", "2+1 Daire"
  description String?
  status      String  @default("ACTIVE") // ACTIVE, WON, LOST, CLOSED
  priority    String  @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  type        String  @default("GENEL") // (Legacy) FIRSAT, SIKAYET, RANDEVU, DESTEK, IS_BASVURUSU, GENEL

  // Vaka Tipi Referansı
  caseTypeId String?
  caseType   CaseType? @relation(fields: [caseTypeId], references: [id], onDelete: SetNull)

  // Pipeline aşaması
  funnelType    String? // Pipeline ID (Funnel)
  funnelStageId String? // Stage ID (FunnelStage)

  // Atama
  assignedToId   String? // Atanan kişi
  assignedTeamId String? // Atanan takım

  // Zaman
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  closedAt   DateTime?
  wonAt      DateTime?
  lostAt     DateTime?
  lostReason String?

  // İlişkiler
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact       Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo    User?             @relation("CaseAssignee", fields: [assignedToId], references: [id])
  team          Team?             @relation(fields: [assignedTeamId], references: [id])
  conversations Conversation[]
  activities    ContactActivity[]
  deals         Deal[]

  // Kampanya & Kaynak takibi
  campaignId String?
  campaign   MarketingCampaign? @relation(fields: [campaignId], references: [id])
  source     String? // GOOGLE_ADS | META_ADS | WHATSAPP_AD | FORM | CAMPAIGN | COLD_CALL | REFERRAL | ORGANIC | MANUAL

  // Ürün / Kategori
  categoryId      String?
  category        TopicCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  products        String         @default("[]") // JSON array [{productId, name, quantity, unitPrice}]
  leadScore       Int            @default(0)
  leadTemperature String         @default("COLD")

  // Şube
  branchId String?
  branch   AppointmentBranch? @relation("CaseBranch", fields: [branchId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([contactId])
  @@index([workspaceId, contactId, status])
  @@index([workspaceId, status])
  @@index([caseNumber])
  @@index([branchId])
  @@map("cases")
}

model Product {
  id              String   @id @default(uuid())
  workspaceId     String
  name            String
  description     String?
  groupName       String?
  categoryId      String? // TopicCategory ile doğrudan ilişki
  unit            String?
  price           Float    @default(0)
  priceUSD        Float?
  priceEUR        Float?
  priceGBP        Float?
  discountedPrice Float?
  tax1Type        String?
  tax1Rate        Float    @default(0)
  tax2Type        String?
  tax2Rate        Float    @default(0)
  isActive        Boolean  @default(true)
  aiContext       String?  @db.Text // Bot için satış notları
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Ürün grubu hiyerarşisi
  parentId String? // Üst ürün grubu
  isGroup  Boolean @default(false) // true ise bu bir ürün grubu

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category         TopicCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parent           Product?          @relation("ProductHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Product[]         @relation("ProductHierarchy")
  features         ProductFeature[]
  media            ProductMedia[]
  productBranches  ProductBranch[]
  resourceProducts ResourceProduct[]

  @@index([workspaceId])
  @@index([workspaceId, groupName])
  @@index([categoryId])
  @@index([parentId])
  @@map("products")
}

model ProductFeature {
  id           String   @id @default(uuid())
  productId    String
  featureKey   String // Örn: "Renk", "Metrekare", "Ameliyat Süresi"
  featureValue String // Örn: "Kırmızı", "120", "2 Saat"
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_features")
}

model ProductMedia {
  id        String   @id @default(uuid())
  productId String
  mediaUrl  String
  mediaType String? // Örn: "IMAGE", "PDF", "VIDEO"
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model MarketingCampaign {
  id             String               @id @default(uuid())
  workspaceId    String
  name           String
  description    String?
  status         String               @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED
  budget         Float? // Toplam bütçe (TL)
  startDate      DateTime?
  endDate        DateTime?
  // Legacy — geriye uyumluluk
  templateId     String?
  type           String               @default("BULK") // BULK | AUTO_DRIP | AUTO_TRIGGERED | AUTO_RECURRING
  // 4 Temel Kampanya Türü: ONE_TIME (Tek Seferlik), RECURRING (Tekrarlı), EVENT_BASED (Olay Bazlı), DAY_BASED (Gün/Süreç Bazlı)
  campaignType         String               @default("ONE_TIME") // ONE_TIME | RECURRING | EVENT_BASED | DAY_BASED
  // Tekrarlı Gönderim (Haftalık / Aylık bülten vb.)
  recurringFrequency   String?              // WEEKLY, MONTHLY, BIWEEKLY, DAILY
  recurringDayOfWeek   Int?                 // 1 (Pazartesi) .. 7 (Pazar)
  recurringDayOfMonth  Int?                 // 1 .. 31
  recurringTime        String?              // "10:00"
  lastRunAt            DateTime?
  nextRunAt            DateTime?
  // Olay & Gün Bazlı Tetikleyiciler
  eventTrigger         String?              // STAGE_CHANGE | UNCONTACTED_LEAD | TAG_ADDED | NEW_LEAD
  eventConfig          String?              @db.Text // JSON: { funnelId, stageId, uncontactedDays: 30 }
  dayTrigger           String?              // INACTIVE_DAYS | BIRTHDAY | CUSTOMER_AGE_DAYS
  dayConfig            String?              @db.Text // JSON: { days: 90, followUps: [100, 120] }
  // Otomatik Yeniden Deneme (Auto-retry)
  autoRetry            Boolean              @default(true)
  maxRetries           Int                  @default(3)
  retryIntervalMinutes Int                  @default(15)
  automationId   String?
  scheduledAt    DateTime?
  // Şablon Kampanya Alanları
  triggerType      String?              // NEW_CONTACT | INACTIVE_DAYS | BIRTHDAY | HOT_LEAD | POST_SALE | ANNIVERSARY | SPECIAL_DAY
  triggerConfig    String?              // JSON: { inactiveDays: 30, daysAfterClose: 1, ... }
  isSystemTemplate Boolean             @default(false) // Workspace oluşturulunca otomatik oluşturulan
  sentAt         DateTime?
  totalCount     Int                  @default(0)
  sentCount      Int                  @default(0)
  deliveredCount Int                  @default(0)
  readCount      Int                  @default(0)
  failedCount    Int                  @default(0)
  repliedCount   Int                  @default(0)
  convertedCount Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template       WhatsappTemplate?    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recipients     MarketingRecipient[] // Legacy
  conversations  Conversation[]
  cases          Case[]
  groups         CampaignGroup[] // Yeni: reklam grupları (Ad Sets)
  messagesLegacy CampaignMessage[] // Legacy: eski mesajlar

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("marketing_campaigns")
}

// Reklam Grubu (Ad Set) — hedef kitle + kanal + mesajlar
model CampaignGroup {
  id             String    @id @default(uuid())
  campaignId     String
  name           String // "VIP WhatsApp", "Yeni Lead Arama"
  groupTag       String? // Gruplama etiketi: aynı tag'e sahip gönderimler bir "Reklam Grubu" oluşturur
  channel        String    @default("WHATSAPP") // WHATSAPP, AI_CALL, EMAIL, SMS, GOOGLE_ADS, META_ADS
  // Hedef kitle
  listId         String? // ContactGroup ID
  segmentId      String? // Smart segment slug
  segmentName    String? // Segment adı snapshot
  // Bütçe ve zamanlama (reklam kanalları için)
  budget         Float? // Günlük bütçe
  scheduledAt    DateTime? // Planlı başlangıç
  // Drip / Otomatik dizi ayarları
  delayDays      Int       @default(0)  // Kişi oluşturulduktan kaç gün sonra gönderilecek
  sortOrder      Int       @default(0)  // Adım sırası
  targetMilestone String?  // "DAY_90", "DAY_100", "DAY_120", "IMMEDIATE" vb.
  // Gönderim ayarları
  sendRate       Int       @default(20) // Dakikada mesaj sayısı
  // İstatistikler
  status         String    @default("DRAFT") // DRAFT, SENDING, COMPLETED, FAILED, PAUSED
  totalCount     Int       @default(0)
  sentCount      Int       @default(0)
  deliveredCount Int       @default(0)
  readCount      Int       @default(0)
  failedCount    Int       @default(0)
  repliedCount   Int       @default(0)
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaign      MarketingCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  list          ContactGroup?          @relation(fields: [listId], references: [id], onDelete: SetNull)
  groupMessages CampaignGroupMessage[]
  recipients    MarketingRecipient[]

  @@index([campaignId])
  @@index([listId])
  @@index([campaignId, groupTag])
  @@map("campaign_groups")
}

// Bağımsız Mesaj — tekrar kullanılabilir içerik
model MarketingMessage {
  id            String   @id @default(uuid())
  workspaceId   String
  name          String // "Yaz fırsatları", "Satış senaryosu"
  channel       String   @default("WHATSAPP") // WHATSAPP, AI_CALL, EMAIL, SMS
  // WhatsApp
  templateId    String? // WA şablon ID
  templateName  String? // WA şablon adı
  // E-posta
  emailSubject  String?
  emailBody     String?  @db.Text
  // AI Arama
  retellAgentId String?
  // Serbest mesaj
  content       String?  @db.Text
  mediaUrl      String?
  // Meta
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  groupMessages CampaignGroupMessage[]

  @@index([workspaceId])
  @@index([workspaceId, channel])
  @@map("marketing_messages")
}

// Grup ↔ Mesaj ilişkisi (çoka çok)
model CampaignGroupMessage {
  id        String   @id @default(uuid())
  groupId   String
  messageId String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  group   CampaignGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  message MarketingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([groupId, messageId])
  @@index([groupId])
  @@index([messageId])
  @@map("campaign_group_messages")
}

// Legacy: Kampanya Mesajı (eski yapı — kaldırılmayacak, uyumluluk)
model CampaignMessage {
  id               String            @id @default(uuid())
  campaignId       String
  channel          String
  name             String?
  templateId       String?
  templateName     String?
  emailSubject     String?
  emailBody        String?           @db.Text
  retellAgentId    String?
  retellTemplateId String?
  content          String?           @db.Text
  mediaUrl         String?
  order            Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  campaignLegacy   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sends            CampaignSend[]

  @@index([campaignId])
  @@map("campaign_messages")
}

// Legacy: Kampanya Gönderimi
model CampaignSend {
  id             String               @id @default(uuid())
  messageId      String
  segmentId      String?
  segmentName    String?
  tagIds         String?
  groupId        String?
  filterSnapshot String?              @db.Text
  scheduledAt    DateTime?
  sentAt         DateTime?
  sendRate       Int                  @default(20)
  status         String               @default("PENDING")
  totalCount     Int                  @default(0)
  sentCount      Int                  @default(0)
  deliveredCount Int                  @default(0)
  readCount      Int                  @default(0)
  failedCount    Int                  @default(0)
  repliedCount   Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  message        CampaignMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipients     MarketingRecipient[]

  @@index([messageId])
  @@index([status, scheduledAt])
  @@map("campaign_sends")
}

model MarketingRecipient {
  id          String            @id @default(uuid())
  campaignId  String
  sendId      String? // Legacy CampaignSend
  groupId     String? // Yeni: CampaignGroup
  contactId   String?
  phone       String?
  email       String?
  name        String?
  messageId   String?           @unique
  status      String            @default("PENDING") // PENDING, SENT, DELIVERED, READ, FAILED
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  failReason  String?
  sentAt      DateTime?
  retryCount  Int               @default(0)
  lastRetryAt DateTime?
  autoRetried Boolean           @default(false)
  createdAt   DateTime          @default(now())
  campaign    MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  send        CampaignSend?     @relation(fields: [sendId], references: [id], onDelete: Cascade)
  group       CampaignGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact     Contact?          @relation("MarketingRecipientContact", fields: [contactId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([sendId])
  @@index([groupId])
  @@index([messageId])
  @@index([contactId])
  @@map("marketing_recipients")
}

model ContactGroup {
  id             String               @id @default(uuid())
  workspaceId    String
  name           String
  description    String?
  icon           String               @default("👥")
  color          String               @default("#2563eb")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  members        ContactGroupMember[]
  campaignGroups CampaignGroup[]

  @@index([workspaceId])
  @@map("contact_groups")
}

model ContactGroupMember {
  id        String       @id @default(uuid())
  groupId   String
  contactId String
  addedAt   DateTime     @default(now())
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([groupId, contactId])
  @@index([groupId])
  @@index([contactId])
  @@map("contact_group_members")
}

model ClassifierRule {
  id          String  @id @default(uuid())
  workspaceId String
  name        String // "Obezite Formu → Satış"
  priority    Int     @default(0) // Lower = higher priority (checked first)
  isActive    Boolean @default(true)

  // Condition
  conditionType String // FORM | CHANNEL | SUB_CHANNEL | KEYWORD | AI | TIME | DEFAULT
  conditions    String @default("{}") // JSON: { formIds:[], channels:[], subChannels:[], keywords:[], matchMode:'ANY', aiDescription:'', timeStart:'', timeEnd:'' }

  // Target
  targetFunnelId String?
  targetStageId  String?
  targetTeamId   String?

  // Optional automation to trigger
  automationId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, priority])
  @@index([workspaceId, isActive])
  @@map("classifier_rules")
}

// ==========================================
// TEMPLATES (Email & SMS)
// ==========================================

model EmailTemplate {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  subject     String
  bodyHtml    String    @db.Text
  bodyText    String?   @db.Text
  variables   String? // JSON: ["{{ad}}", "{{firma}}"]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("email_templates")
}

model SmsTemplate {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  bodyText    String    @db.Text
  variables   String? // JSON: ["{{ad}}", "{{tarih}}"]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("sms_templates")
}

// Telsam PBX Entegrasyonu
model TelsamConfig {
  id          String   @id @default(uuid())
  workspaceId String   @unique
  siteUrl     String // e.g. "pbx2.telsam.com.tr"
  username    String
  password    String
  isActive    Boolean  @default(true)
  webhookUrl  String? // Auto-generated webhook URL for this workspace
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  extensions TelsamExtension[]
  callLogs   TelsamCallLog[]

  @@index([workspaceId])
  @@map("telsam_configs")
}

model TelsamExtension {
  id        String   @id @default(uuid())
  configId  String
  userId    String
  internal  String // Dahili numara (e.g. "110")
  label     String? // Friendly name
  createdAt DateTime @default(now())

  config TelsamConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, userId])
  @@unique([configId, internal])
  @@map("telsam_extensions")
}

model TelsamCallLog {
  id           String   @id @default(uuid())
  configId     String
  workspaceId  String
  contactId    String?
  externalId   String? // CDR ID from Telsam
  direction    String // INBOUND, OUTBOUND
  src          String // Caller number
  dst          String // Called number  
  duration     Int      @default(0) // Seconds
  disposition  String? // ANSWERED, NO ANSWER, BUSY, FAILED
  callDate     DateTime
  recordingUrl String? // Path/URL to downloaded recording
  transcript   String?  @db.Text
  summary      String?  @db.Text
  userId       String? // CRM user who handled this
  createdAt    DateTime @default(now())

  config TelsamConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, externalId])
  @@index([workspaceId, callDate])
  @@index([contactId])
  @@map("telsam_call_logs")
}

// ─── Otomasyon Çalışma Logları ──────────────────────────────────────────
model AutomationLog {
  id          String   @id @default(uuid())
  workspaceId String
  ruleType    String // BIRTHDAY_GREETING, DRIP_DAY_1, CALL_SUCCESS_NOTIFY vs
  contactId   String
  executedAt  DateTime @default(now())
  result      String   @default("SUCCESS") // SUCCESS, FAILED, SKIPPED
  metadata    String?  @db.Text // JSON — ek bilgiler

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId, ruleType, contactId])
  @@index([workspaceId, ruleType, executedAt])
  @@map("automation_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Retell Arama Şablonları
// WhatsApp şablonları gibi, farklı amaçlara yönelik arama senaryoları.
// ─────────────────────────────────────────────────────────────────────────────

model RetellTemplate {
  id           String    @id @default(uuid())
  workspaceId  String
  name         String // "Randevu Teyidi", "Urlaone Bilgilendirme"
  description  String?
  icon         String? // Emoji
  agentId      String // Bağlı Retell agent ID
  beginMessage String?   @db.Text // "Merhaba {{customer_name}}, randevunuzu teyit etmek için aradık."
  promptSuffix String?   @db.Text // Agent prompt'unun sonuna eklenen ek talimat
  dynamicVars  Json? // { "call_purpose": "randevu_teyit", "product": "Urlaone" }
  isActive     Boolean   @default(true)
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("retell_templates")
}

// ─────────────────────────────────────────────────────────────────────────────
// Zamanlanmış Mesajlar (Hatırlatıcılar)
// Bot hatırlatıcıları ve otomasyon gecikmeli mesajları için DB tabanlı kuyruk.
// Cron job her dakika kontrol eder ve gönderir.
// ─────────────────────────────────────────────────────────────────────────────

model ScheduledMessage {
  id             String       @id @default(uuid())
  workspaceId    String
  conversationId String
  contactId      String
  botId          String? // Hangi bot tanımladı
  automationId   String? // Hangi otomasyon kuralından
  content        String       @db.Text
  scheduledAt    DateTime // Ne zaman gönderilecek
  sentAt         DateTime? // Gönderildi mi
  status         String       @default("PENDING") // PENDING, SENT, FAILED, CANCELLED
  failReason     String?
  createdAt      DateTime     @default(now())
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt]) // Cron job: PENDING + scheduledAt <= now()
  @@index([workspaceId])
  @@index([workspaceId, botId])
  @@map("scheduled_messages")
}

// Sistem duyuruları — SUPER_ADMIN tarafından tüm workspace'lere yayınlanan mesajlar
model SystemAnnouncement {
  id        String   @id @default(uuid())
  title     String // Duyuru başlığı
  message   String   @db.Text // Duyuru içeriği
  type      String   @default("UPDATE") // UPDATE, IMPROVEMENT, MAINTENANCE, INFO
  isActive  Boolean  @default(true)
  createdBy String // SUPER_ADMIN user ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_announcements")
}

// Ürün-Şube ilişkisi: Şubeye özel fiyat ve bulunurluk
model ProductBranch {
  id          String   @id @default(uuid())
  productId   String
  branchId    String
  price       Float? // Şubeye özel fiyat (null ise baz fiyat kullanılır)
  isAvailable Boolean  @default(true) // Bu şubede mevcut mu?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  AppointmentBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([productId])
  @@index([branchId])
  @@map("product_branches")
}

// Changelog & WhatsNext — sistem notları
model AppNote {
  id          String   @id @default(uuid())
  workspaceId String
  type        String // CHANGELOG, WHATSNEXT
  module      String? // KISILER, PAZARLAMA, INBOX, TAKIMLAR, SATIS, AYARLAR, OTOMASYONLAR, RAPORLAR, GENEL
  title       String
  content     String?  @db.Text
  version     String? // "v2.4.0" (changelog için)
  status      String   @default("TODO") // TODO, IN_PROGRESS, DONE, IDEA (whatsnext için)
  priority    Int      @default(0) // 0=normal, 1=high, 2=critical
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, type])
  @@index([workspaceId, type, createdAt])
  @@map("app_notes")
}

// AI Token Kullanım Logu — her Gemini çağrısında kaydedilir
model AIUsageLog {
  id             String   @id @default(cuid())
  companyId      String?
  workspaceId    String
  service        String // classifier | auto_reply | scorer | follow_up | bot | manual | note_analysis | routing
  model          String // gemini-2.5-flash, gemini-2.0-flash-lite, gemini-2.5-pro
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  totalTokens    Int      @default(0)
  costUsd        Float    @default(0) // Hesaplanmış USD maliyet
  conversationId String?
  metadata       String?  @db.Text // Ek bilgi (JSON)
  createdAt      DateTime @default(now())

  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([companyId, service])
  @@map("ai_usage_logs")
}

// ========== FATURALANDIRMA MODÜLLERİ ==========

// Paket tanımları (Admin tarafından oluşturulur)
model BillingPlan {
  id                String   @id @default(cuid())
  name              String           // "Temel Paket", "AI Pro"
  description       String?  @db.Text
  monthlyPrice      Float    @default(0)     // Sabit aylık ücret (USD)
  includedAiCredits Float    @default(0)     // Dahil AI kredisi (USD)
  includedCallMins  Int      @default(0)     // Dahil arama dakikası
  costMultiplier    Float    @default(2.0)   // Maliyet çarpanı
  features          String?  @db.Text        // JSON: dahil özellikler listesi
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  companies         CompanyBilling[]

  @@map("billing_plans")
}

// Şirket fatura bilgileri (Company bazlı)
model CompanyBilling {
  id              String       @id @default(cuid())
  companyId       String       @unique
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId          String?
  plan            BillingPlan? @relation(fields: [planId], references: [id])
  creditBalance   Float        @default(0)     // Kalan kredi (USD)
  billingType     String       @default("POSTPAID") // PREPAID | POSTPAID
  costMultiplier  Float        @default(2.0)   // Özel çarpan (plan override)
  billingEmail    String?
  billingName     String?
  taxNumber       String?
  taxOffice       String?
  notes           String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  invoices        Invoice[]
  payments        Payment[]

  @@index([companyId])
  @@map("company_billings")
}

// Tüketim kayıtları (otomatik oluşturulur)
model UsageRecord {
  id            String    @id @default(cuid())
  companyId     String
  workspaceId   String
  type          String    // AI_CHAT | AI_CALL | WHATSAPP_TEMPLATE | SMS | EMAIL
  quantity      Float     @default(0)   // Miktar (token, dakika, adet)
  unit          String    @default("unit") // token | minute | message
  costUsd       Float     @default(0)   // Gerçek maliyet
  priceUsd      Float     @default(0)   // Müşteri fiyatı (costUsd × çarpan)
  metadata      String?   @db.Text      // JSON: model, service, callId vb.
  invoiceId     String?
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([companyId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([invoiceId])
  @@map("usage_records")
}

// Faturalar
model Invoice {
  id               String         @id @default(cuid())
  companyBillingId  String
  companyBilling    CompanyBilling @relation(fields: [companyBillingId], references: [id], onDelete: Cascade)
  invoiceNumber     String         @unique        // INS-2026-001
  period            String                        // "2026-09"
  subtotal          Float          @default(0)
  planAmount        Float          @default(0)    // Sabit paket ücreti
  usageAmount       Float          @default(0)    // Kullanım toplamı
  totalAmount       Float          @default(0)    // Genel toplam
  paidAmount        Float          @default(0)    // Ödenen tutar
  status            String         @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE | CANCELLED
  dueDate           DateTime?
  notes             String?        @db.Text
  items             String?        @db.Text       // JSON: fatura kalemleri
  usageRecords      UsageRecord[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([companyBillingId])
  @@index([status])
  @@map("invoices")
}

// Ödeme kayıtları
model Payment {
  id               String         @id @default(cuid())
  companyBillingId  String
  companyBilling    CompanyBilling @relation(fields: [companyBillingId], references: [id], onDelete: Cascade)
  amount            Float                         // Ödeme tutarı (USD)
  method            String         @default("BANK_TRANSFER") // BANK_TRANSFER | CREDIT_CARD | CASH
  reference         String?                       // Dekont no, açıklama
  invoiceId         String?                       // Bağlı fatura ID
  notes             String?
  createdAt         DateTime       @default(now())

  @@index([companyBillingId])
  @@map("payments")
}
