  body        String
  data        String? // JSON - conversationId, teamId, etc.
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([workspaceId, userId])
  @@map("notifications")
}

model RetellCall {
